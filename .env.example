# GEMINI_API_KEY: Optional server-side Google Gemini API key (never exposed to browser).
# AI Studio injects this at runtime from user secrets. Strictly separate from OMNIAI_MASTER_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (used for GitHub OAuth callbacks: <APP_URL>/auth/callback).
APP_URL="MY_APP_URL"

# PORT: Server HTTP listen port (defaults to 3000 in server.ts).
PORT="3000"

# NODE_ENV: Set to "production" for production deployments.
NODE_ENV="development"

# ALLOWED_ORIGINS: Comma-separated list of additional trusted origins for CORS.
ALLOWED_ORIGINS=""

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Required for GitHub OAuth integration.
# Create an OAuth App at https://github.com/settings/developers with callback URL <APP_URL>/auth/callback
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# OMNIAI_MASTER_KEY & SESSION_SECRET: Required in production (min 16 chars, 32+ random bytes recommended).
# Used to derive AES-256-GCM keys for encrypted HTTP-only cookies and database credential vaults.
# Never reuse GEMINI_API_KEY here.
OMNIAI_MASTER_KEY="REPLACE_WITH_SECURE_RANDOM_32_BYTE_MASTER_KEY"
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_32_BYTE_SESSION_SECRET"

# ALLOW_LOCAL_MODEL_URLS: Set to "true" ONLY when running locally against private Ollama/vLLM/LM Studio endpoints.
# Private/loopback IP ranges remain blocked by the server SSRF guard unless explicitly enabled.
ALLOW_LOCAL_MODEL_URLS="false"

# DATABASE_URL: PostgreSQL connection string for hosted multi-user deployments.
# Server automatically runs transactional SQL migrations in server/db/migrations/ (001 & 002) at startup.
DATABASE_URL=""

# DATABASE_SSL / PGSSLMODE: Set DATABASE_SSL="true" (or "require") for TLS-enabled managed PostgreSQL instances.
DATABASE_SSL="false"

# ALLOW_LOCAL_FILE_DB: Local development fallback (.omniai-data/) when DATABASE_URL is unset.
# Set to "true" only if you intentionally allow file-based fallback in non-PostgreSQL deployments.
ALLOW_LOCAL_FILE_DB="true"

# --- Optional Live Integration Test Variables (never required for unit/E2E suites) ---
# TEST_DATABASE_URL=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
