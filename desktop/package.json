{
  "name": "omniai-studio-desktop",
  "version": "1.0.0",
  "description": "OmniAI Studio Windows & Cross-Platform Desktop Runtime (Electron)",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist:unpacked": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "package:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.omniaistudio.desktop",
    "productName": "OmniAI Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
